# RAPS MCP HTTP Server — serves the MCP protocol over HTTP
# Build: docker build -f deploy/docker/Dockerfile.mcp -t rapscli/raps-mcp .

FROM rust:1.88-alpine AS builder
RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static pkgconf
WORKDIR /build
COPY . .
RUN cargo build --release --features mcp-http -p raps-cli \
    && strip target/release/raps

FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /build/target/release/raps /usr/local/bin/raps
EXPOSE 8080
ENV RUST_LOG=info
ENTRYPOINT ["raps"]
CMD ["mcp", "--transport", "http", "--port", "8080"]
